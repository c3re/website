{
  "name": "c3re-website",
  "main": "worker/index.mjs",
  "account_id": "9a562df9759b0d525872d399986f10ef",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "secrets": {
    "required": ["DEMO_USERNAME", "DEMO_PASSWORD"]
  },
  "build": {
    "command": "make BASEURL=https://c3re.de check"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "c3re.de",
      "custom_domain": true
    }
  ]
}
